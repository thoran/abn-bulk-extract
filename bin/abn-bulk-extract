#!/usr/bin/env ruby
# abn-bulk-extract

require 'data_gov_au'
require 'DataGovAu/AbnBulkExtract'
require 'switches.rb'
require 'yaml'

BYTES_PER_KILOBYTE = 1024
BYTES_PER_MEGABYTE = 1_048_576
CONFIG_PATH = '~/.config/abn-bulk-extract/config.yaml'
DATASETS = ['abr']
SECONDS_PER_MINUTE = 60
SETTINGS = [:api_url, :directory, :user_agent]

def usage
  puts "abn-bulk-extract - The Australian Business Register's weekly ABN bulk extract, from data.gov.au: fetch, compare and parse."
  puts
  puts "Usage: abn-bulk-extract DATASET [options]"
  puts
  puts "Datasets:"
  puts "  abr                       The Australian Business Register's weekly ABN bulk extract"
  puts
  puts "Options:"
  puts "  -c, --compare             Set each release held against the one before it, retrieving nothing"
  puts "  -d, --directory DIR       Where the extract is kept (default: $XDG_DATA_HOME/abn-bulk-extract)"
  puts "  -n, --dry-run             Report what would be retrieved and compared without doing either"
  puts "  -p, --parse               Parse the newest release held, retrieving nothing"
  puts "  -q, --quiet               Report nothing but errors"
  puts "  -h, --help                Show this help"
end

def switches
  @switches ||= Switches.new do |s|
    s.boolean(:c, :compare){'Set each release held against the one before it, retrieving nothing'}
    s.optional(:d, :directory){'Where the extract is kept (default: $XDG_DATA_HOME/abn-bulk-extract)'}
    s.boolean(:n, :dry_run){'Report what would be retrieved and compared without doing either'}
    s.boolean(:p, :parse){'Parse the newest release held, retrieving nothing'}
    s.boolean(:q, :quiet){'Report nothing but errors'}
    s.perform(:h, :help?) do
      usage
      exit
    end
  end
end

# What is left once the switches are read, OptionParser taking them out of ARGV wherever they stood.
def dataset
  @dataset ||= ARGV.first
end

# The extract's own directory, holding releases/.
def default_directory
  data_home = ENV['XDG_DATA_HOME'].to_s
  File.join(data_home.empty? ? File.join('~', '.local', 'share') : data_home, 'abn-bulk-extract')
end

def config_path
  @config_path ||= File.expand_path(CONFIG_PATH)
end

def stored_settings
  @stored_settings ||= File.exist?(config_path) ? read_settings : {}
end

# A file which is not a mapping stops the run rather than leaving it on the defaults, which would hide a typo in the one place the machine's own settings live.
def read_settings
  settings = YAML.safe_load_file(config_path) || {}
  report_failure("#{config_path} does not hold a mapping") unless settings.is_a?(Hash)
  settings.transform_keys(&:to_sym).tap{|symbolised| check_retired_settings(symbolised)}
end

# data_directory named a directory beneath which abr/ held the extract, where directory names the extract's own. A file still holding it stops the run, rather than the releases being looked for, and retrieved again, where they are not.
def check_retired_settings(settings)
  return unless settings.key?(:data_directory)
  report_failure("#{config_path} holds data_directory, which is no longer read: directory names the extract's own directory, the one holding releases/")
end

def switched_settings
  {directory: switches.directory}
end

# A setting left blank or a switch left off is nil, and leaves what lies beneath it standing. Only the settings the library takes are passed in.
def settings
  @settings ||= {directory: default_directory}.merge(stored_settings.compact, switched_settings.compact).slice(*SETTINGS)
end

def config
  @config ||= DataGovAu::AbnBulkExtract::Config.new(**settings)
end

def fetch
  @fetch ||= DataGovAu::AbnBulkExtract::Fetch.new(config)
end

# The newest release on disk, which is read from the directory names and so costs nothing: parsing goes nowhere near the network.
def held_release
  @held_release ||= (
    date = DataGovAu::AbnBulkExtract::Release.dates_held(config).first
    raise DataGovAu::AbnBulkExtract::NothingToParse, "no release is held in #{config.releases_directory}" unless date
    DataGovAu::AbnBulkExtract::Release.new(config, date)
  )
end

def report(message)
  puts message unless switches.quiet?
end

def reported_size(size)
  return 'size unknown' if size.nil?
  return "#{(size.to_f / BYTES_PER_MEGABYTE).round} MB" if size >= BYTES_PER_MEGABYTE
  "#{(size.to_f / BYTES_PER_KILOBYTE).round} kB"
end

# Rounded before it is divided, so that no duration reads as 60 seconds.
def reported_duration(seconds)
  whole_seconds = seconds.round
  return "#{whole_seconds} s" if whole_seconds < SECONDS_PER_MINUTE
  "#{whole_seconds / SECONDS_PER_MINUTE} m #{whole_seconds % SECONDS_PER_MINUTE} s"
end

def describe(resource)
  "  #{resource.filename} (#{reported_size(resource.size)})"
end

def report_release
  report("release:   #{fetch.release}")
  report("catalogue: #{fetch.modified_on.strftime('%Y%m%d')}")
  report("licence:   #{fetch.dataset.licence}")
  report("held:      #{fetch.resources.length - fetch.release.missing.length} of #{fetch.resources.length} files")
  fetch.release.missing.each{|resource| report(describe(resource))}
end

def retrieve_release
  report(fetch.release.complete? ? 'nothing to retrieve' : "retrieving into #{fetch.release.directory}")
  fetch.perform{|resource| report("  #{resource.filename}")}
end

def fetch_release
  report_release
  retrieve_release unless switches.dry_run?
end

# Read from what is on disk, and so after any fetch in the same run.
def comparisons
  @comparisons ||= DataGovAu::AbnBulkExtract::Comparison.pending(config)
end

def now
  Process.clock_gettime(Process::CLOCK_MONOTONIC)
end

def report_comparisons
  report('nothing to compare') if comparisons.empty?
  comparisons.each{|comparison| report("to compare: #{comparison.newer} against #{comparison.older}")}
end

# A dry run reports what it would compare, whether it was asked for alone or after a fetch.
def compare_releases
  return report_comparisons if switches.dry_run?
  report('nothing to compare') if comparisons.empty?
  comparisons.each{|comparison| compare(comparison)}
end

# Two passes over the pair: one to write the delta, and one to rebuild the newer release from it, which is what the delta is trusted on.
def compare(comparison)
  report("comparing: #{comparison.newer} against #{comparison.older}")
  started = now
  comparison.perform do |stage|
    case stage
    when :written then report_delta(comparison.delta, now - started)
    when :checked then report("  rebuilt exactly, in #{reported_duration(now - started)}")
    end
  end
end

def report_delta(delta, seconds)
  report("  #{delta.added} added, #{delta.changed} changed, #{delta.removed} removed, in #{reported_duration(seconds)}")
end

def run_stages
  fetch_release
  compare_releases
end

# Each file is set against the count it carries itself, so that a file which gave up fewer records than it promised, or which reports an error, is reported rather than passing as a smaller week.
def parse_release
  report("release:   #{held_release}")
  started = now
  records = 0
  not_whole = []
  DataGovAu::AbnBulkExtract::Extract.new(held_release).each_file do |member, parser|
    parser.each_record{}
    records += parser.records_parsed
    report(file_report(member, parser))
    not_whole << member unless parser.whole?
  end
  report("total:     #{records} records in #{reported_duration(now - started)}")
  report_not_whole(not_whole) unless not_whole.empty?
end

def file_report(member, parser)
  line = "  #{member}  #{parser.records_parsed} of #{parser.record_count}"
  return line if parser.error_free?
  "#{line}  error: #{parser.error || 'not given'}"
end

def report_not_whole(members)
  report_failure("fewer records than promised, or an error reported, in #{members.join(', ')}")
end

def report_failure(message)
  $stderr.puts "abn-bulk-extract: #{message}"
  exit 1
end

def check_dataset
  return if DATASETS.include?(dataset)
  report_failure("#{dataset ? "#{dataset} is not a dataset" : 'no dataset named'}; one of #{DATASETS.join(', ')}")
end

def main
  $stdout.sync = true
  switches
  check_dataset
  if switches.parse?
    parse_release
  elsif switches.compare?
    compare_releases
  else
    run_stages
  end
rescue DataGovAu::Error => error
  report_failure(error.message)
end

main
